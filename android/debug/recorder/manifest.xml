        <activity
            android:name="com.titankeys.keyboard.RecorderActivity"
            android:label="TitanKeys Recorder"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.titankeys.keyboard.TouchSizeActivity"
            android:label="TitanKeys Touch size"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Copies the raw typing log where adb can pull it. Only adb, which holds DUMP, can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.RawLogPull"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Copies the typing log and the last bug recording to files/logs/ and answers with their time range (LogPull.kt).
             Only adb, which holds DUMP, can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.LogPull"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Resets the connected features for phone tests. Only adb, which holds DUMP, can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.ConnectedReset"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Collects garbage and lists the guides still in memory, for the memory stress check (#85). Only adb can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.LeakCheck"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Private, bounded own-surface PNG capture/readback. No display capture. -->
        <receiver android:name="com.titankeys.keyboard.OwnSurfaceCapture"
            android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name="com.titankeys.keyboard.TestScreenLease"
            android:exported="true" android:permission="android.permission.DUMP" />
        <!-- The phone run's progress as one silent notification (RunStatus.kt). Only adb can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.RunStatus"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Lists the files of Rime's data copy, "BYTES NAME" per line, for the storage checks. Only adb can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.RimeFiles"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- The touch simulator's touchpad (tools/dev/touch): built touchpad events into the keyboard. Only adb can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.TouchFeed"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- The touch simulator's keys, Shift included, built as the phone's keyboard sends them into the keyboard's own key
             handling, without the injector's twin keyboard (tools/dev/touch). Only adb can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.KeyFeed"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Opens the guide at one slide, for the touch simulator's checks of it. Only adb can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.GuideStart"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Sets which input methods are on and which types, for the touch simulator's languages batch. Only adb can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.InputMethodsSet"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- The haptics played lately, from the Haptics lab's feed, for the touch simulator's checks. Only adb can send to it. -->
        <receiver
            android:name="com.titankeys.keyboard.HapticsDump"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name="com.titankeys.keyboard.SpaceGestureActivity"
            android:label="TitanKeys Space gestures"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
