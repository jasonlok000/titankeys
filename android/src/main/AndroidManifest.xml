<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Announcements and data contributions only, as the privacy policy says. Nothing that you type is sent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Announcements show as a notification. The app asks first, with the reason. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only with "Names from my contacts" on: given and family names, kept in memory on the phone, never sent. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The link with Titan Tools, for its keyboard light: only apps signed with the same key hold it (TitanToolsLink.kt). Both
         apps declare it, so either can be installed first. -->
    <permission
        android:name="com.everyonesniche.titantools.permission.LINK"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.everyonesniche.titantools.permission.LINK" />
    <queries>
        <package android:name="com.everyonesniche.titantools" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The apps on the home screen: the keyboard knows their names as words, and Settings offers them for exact typing.
             Not every installed package. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The phone's Shortcut keys page, which Settings > Setup opens for the Sym and fn keys. -->
        <package android:name="com.agui.shortcutsettings" />
    </queries>
    <!-- Opted in, apps play their own keyboard-dismiss animation on back and never pass back on. -->
    <application android:enableOnBackInvokedCallback="false">
        <activity
            android:name="com.vandam.ink.BackupActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <activity
            android:name="com.vandam.ink.ContactsPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <!-- The support page: one offline HTML page from the app's assets in a WebView, with no network (SupportWebActivity.kt). -->
        <activity
            android:name="com.titankeys.support.SupportWebActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <activity
            android:name="com.titankeys.keyboard.ShareDisclosureActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <activity
            android:name="com.titankeys.keyboard.BackDisclosureActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <activity
            android:name="com.vandam.ink.RawLogExportActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <!-- The Haptics lab's graph. Only TitanKeys Debug opens it, and it closes at once in any other build. -->
        <activity
            android:name="com.titankeys.keyboard.HapticsLabActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <!-- Key calibration, which lines the drawn keys up with the real ones. Only TitanKeys Debug opens it, and it closes at once in any other build. -->
        <activity
            android:name="com.titankeys.keyboard.KeyCalibrationActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <!-- One still frame of the new guide, for review. Not exported here: tools/debug.sh exports it in TitanKeys Debug only, so
             that adb can open it, and it closes at once outside TitanKeys Debug anyway. -->
        <activity
            android:name="com.titankeys.keyboard.GuideFrameActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <!-- Reset literally everything restarts TitanKeys through this, in a process of its own: see FreshStart.kt. -->
        <activity
            android:name="com.titankeys.keyboard.FreshStartActivity"
            android:exported="false"
            android:process=":restart"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.titankeys.keyboard.GuideActivity"
            android:exported="false"
            android:theme="@style/GuideTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <service
            android:name="com.titankeys.keyboard.TitanKeysIme"
            android:label="TitanKeys Keyboard"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>
        <service
            android:name="com.titankeys.keyboard.BackService"
            android:label="TitanKeys Keyboard"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/back_service" />
        </service>
        <service
            android:name="com.titankeys.connected.ConnectedJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name="com.titankeys.connected.NewsReceiver"
            android:exported="false" />
        <!-- After an update: if the rename (#81) turned the keyboard or Back off, one quiet notification says so. -->
        <receiver
            android:name="com.titankeys.keyboard.UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Record a bug (#64): the notification's Stop, and the read-only file lent to the app picked in the share sheet. -->
        <receiver
            android:name="com.titankeys.keyboard.BugStopReceiver"
            android:exported="false" />
        <!-- The crash offer (#74): keeps the last crash's report on the phone from the moment the process starts, and lends it
             read-only to the mail app when the user emails it. -->
        <provider
            android:name="com.titankeys.keyboard.CrashKeeper"
            android:authorities="${applicationId}.crashkeeper"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name="com.titankeys.keyboard.BugRecordingProvider"
            android:authorities="${applicationId}.bugrecording"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
