<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Announcements and data contributions only, as the privacy policy says. Nothing that you type is sent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Announcements show as a notification. The app asks first, with the reason. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only with "Names from my contacts" on: given and family names, kept in memory on the phone, never sent. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The apps on the home screen: the keyboard knows their names as words, and Settings offers them for exact typing.
             Not every installed package. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The phone's Shortcut keys page, which Settings > Setup opens for the Sym and fn keys. -->
        <package android:name="com.agui.shortcutsettings" />
    </queries>
    <!-- Opted in, apps play their own keyboard-dismiss animation on back and never pass back on. -->
    <application android:enableOnBackInvokedCallback="false">
        <activity
            android:name="com.vandam.ink.LearningTransferActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <activity
            android:name="com.vandam.ink.ContactsPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <activity
            android:name="com.atlas.keyboard.BackDisclosureActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <activity
            android:name="com.vandam.ink.RawLogExportActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <!-- The Haptics lab's graph. Only TitanKeys Debug opens it, and it closes at once in any other build. -->
        <activity
            android:name="com.atlas.keyboard.HapticsLabActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <!-- Key calibration, which lines the drawn keys up with the real ones. Only TitanKeys Debug opens it, and it closes at once in any other build. -->
        <activity
            android:name="com.atlas.keyboard.KeyCalibrationActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <!-- One still frame of the new guide, for review. Exported so that adb can open it; it closes at once outside TitanKeys Debug. -->
        <activity
            android:name="com.atlas.keyboard.GuideFrameActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <activity
            android:name="com.atlas.keyboard.GuideActivity"
            android:exported="false"
            android:theme="@style/GuideTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <service
            android:name="com.atlas.keyboard.AtlasIme"
            android:label="TitanKeys"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>
        <service
            android:name="com.atlas.keyboard.BackService"
            android:label="TitanKeys"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/back_service" />
        </service>
        <service
            android:name="com.atlas.connected.ConnectedJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name="com.atlas.connected.NewsReceiver"
            android:exported="false" />
        <!-- Record a bug (#64): the notification's Stop, and the read-only file lent to the app picked in the share sheet. -->
        <receiver
            android:name="com.atlas.keyboard.BugStopReceiver"
            android:exported="false" />
        <provider
            android:name="com.atlas.keyboard.BugRecordingProvider"
            android:authorities="${applicationId}.bugrecording"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
