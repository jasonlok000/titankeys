<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <!-- Opted in, apps play their own keyboard-dismiss animation on back and never pass back on. -->
    <application android:enableOnBackInvokedCallback="false">
        <activity
            android:name="com.vandam.ink.LearningTransferActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <activity
            android:name="com.vandam.ink.RawLogExportActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
        <service
            android:name="com.atlas.keyboard.AtlasIme"
            android:label="TitanKeys"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>
        <service
            android:name="com.atlas.keyboard.BackService"
            android:label="TitanKeys"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/back_service" />
        </service>
    </application>
</manifest>
