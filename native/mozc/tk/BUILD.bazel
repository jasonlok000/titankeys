# TitanKeys' Japanese engine in Mozc's tree: native/mozc/build.sh copies this folder to src/android/tk.
# libmozc_tk.so (arm64) for the app, with only JNI_OnLoad exported, and mozc_tool for the PC, both on tk_core.

load(
    "//:build_defs.bzl",
    "MOZC_TAGS",
    "mozc_cc_binary",
    "mozc_cc_library",
)
load("//android/jni:cross_build_binary.bzl", "cross_build_binary")

mozc_cc_library(
    name = "tk_core",
    srcs = ["tk_core.cc"],
    hdrs = ["tk_core.h"],
    deps = [
        "//base:system_util",
        "//data_manager",
        "//engine",
        "//protocol:candidate_window_cc_proto",
        "//protocol:commands_cc_proto",
        "//session:session_handler",
        "@com_google_absl//absl/status:statusor",
    ],
)

mozc_cc_library(
    name = "tk_jni",
    srcs = ["tk_jni.cc"],
    tags = MOZC_TAGS.ANDROID_ONLY,
    deps = [":tk_core"],
    alwayslink = 1,
)

mozc_cc_binary(
    name = "mozc_tk",
    srcs = [],
    additional_linker_inputs = ["tk.map"],
    linkopts = [
        # 16 KB pages, as Android 15+ wants.
        "-Wl,-z,max-page-size=16384",
        # Only JNI_OnLoad: Mozc's own libc++ and everything else stay inside.
        "-Wl,--version-script=$(location tk.map)",
        "-llog",
    ],
    linkshared = 1,
    tags = MOZC_TAGS.ANDROID_ONLY,
    target_compatible_with = ["@platforms//os:android"],
    deps = [":tk_jni"],
)

platform(
    name = "arm64-v8a",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:android",
    ],
)

cross_build_binary(
    name = "mozc_tk.arm64",
    cpu = "arm64-v8a",
    platform = ":arm64-v8a",
    tags = MOZC_TAGS.ANDROID_ONLY,
    target = ":mozc_tk",
)

mozc_cc_binary(
    name = "mozc_tool",
    srcs = ["tk_tool.cc"],
    deps = [":tk_core"],
)
