{
  "name": "TitanKeys: Traditional Chinese to Traditional Chinese (Taiwan standard, with Taiwan phrases)",
  "normalization": [
    { "dict": { "type": "ocd2", "file": "CJK_Compatibility_Ideographs.ocd2" } }
  ],
  "segmentation": {
    "type": "mmseg",
    "dict": { "type": "ocd2", "file": "TWPhrases.ocd2" }
  },
  "conversion_chain": [
    { "dict": { "type": "ocd2", "file": "TWPhrases.ocd2" } },
    { "dict": { "type": "group", "match_policy": "short_circuit", "dicts": [
      { "type": "ocd2", "file": "TWVariantsPhrases.ocd2" },
      { "type": "ocd2", "file": "TWVariants.ocd2" } ] } }
  ]
}
