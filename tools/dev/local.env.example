# Machine facts for the maintainer tools in tools/dev. Copy this file to tools/dev/local.env (ignored by git) and fill it in.
# Every value has a default, so only set the ones that differ on your machine. Paths are as seen from WSL.

# The phone, as adb names it: a USB serial, or an address and port for wireless debugging. Empty: the only connected device.
TK_ADB_SERIAL=
# The address alone, without the port, for reconnect.sh after the phone restarts.
TK_ADB_HOST=

# The WSL distro and user that build TitanKeys, for running these tools from Windows.
TK_WSL_DISTRO=atlas-build
TK_WSL_USER=dev

# Where the build toolchain lives: Kotlin, the Android SDK, the shared Ink checkout and the seed build copy.
TK_BUILD=$HOME/build
TK_ENV_SCRIPT=$HOME/titankeys-env.sh

# Where phone screenshots, screen recordings and preview values are written. Outside the repo.
TK_OUT=$HOME/tk-out

# The swipe recordings and typing logs. They hold typed text, so they stay on this machine and never go in the repo.
TK_PRIVATE=$HOME/tk-private/swipe-baseline
TK_DATA=$HOME/tk-data
# ONNX Runtime for Android (see swipe-baseline/README.md for the download).
TK_ORT=$HOME/tk-private/ort

# The GPU machine for fine-tuning (swipe-baseline/tools/gpu), reached over SSH. Leave empty if you have none.
TK_GPU_HOST=
TK_GPU_KEY=
