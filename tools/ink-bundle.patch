+/// An App Bundle is signed as a JAR, which apksigner can't check, so the JDK's jarsigner does.
+fn verify_bundle(bundle: &Path, verbose: bool) -> Result<()> {
+    let mut command = Command::new("jarsigner");
+    // Not -strict: Gradle writes the bundle's manifest last, which -strict reports, though the signature is good.
+    command.arg("-verify").arg(bundle);
+    process::run_quiet(&mut command, "Verifying AAB signature", verbose)?;
+    Ok(())
+}
