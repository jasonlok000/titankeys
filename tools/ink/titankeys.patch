+#[test]
+fn accessibility_custom_drawn_controls_dispatch_once_and_read_only_values_stay_read_only() {
+    let ops = [
+        control(2, 1, HostKind::Stack, json!({ "accessibilityLabel": "Confirm", "onPress": true })),
+        control(3, 2, HostKind::Canvas, json!({ "width": 596, "height": 96 })),
+        control(4, 1, HostKind::Stack, json!({ "accessibilityLabel": "Status", "accessibilityValue": "Ready" })),
+        control(5, 4, HostKind::Canvas, json!({ "width": 596, "height": 48 })),
+        control(6, 1, HostKind::Stack, json!({ "accessibilityLabel": ";", "accessibilitySelected": true, "onPress": true })),
+        control(7, 6, HostKind::Canvas, json!({ "width": 596, "height": 72 })),
+    ].into_iter().flatten().collect();
+    let (mut tree, mut engine) = page(1400, ops);
+    let snapshot = engine.accessibility_snapshot();
+    assert_eq!(snapshot["controls"].as_array().unwrap().len(), 3);
+    assert_eq!(row(&snapshot, 4, false)["detail"], "Ready");
+    assert_eq!(row(&snapshot, 4, false)["click"], false);
+    assert_eq!(row(&snapshot, 6, false)["checked"], true);
+    assert_click(&mut engine, 2, false, "onPress", json!([]));
+    assert!(!engine.accessibility_click(4, false).activated);
+    tree.apply(ReactCommit(vec![Operation::Remove { id: 2, parent: 1 }]), &mut engine).unwrap();
+    assert!(!engine.accessibility_click(2, false).activated);
+}
