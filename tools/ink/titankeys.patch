+use super::*;
+use ink_protocol::{HostKind, Operation};
+
+fn control(id: usize, parent: usize, kind: HostKind, props: Value) -> [Operation; 2] {
+    [
+        Operation::Create { id, r#type: kind, props: props.as_object().unwrap().clone() },
+        Operation::Insert { id, parent, before: None },
+    ]
+}
+
+fn page(height: u32, children: Vec<Operation>) -> (ReactTree, Engine) {
+    let icon = ReactIcon { name: "close".into(), filled: false, id: 7, width: 1, height: 1, pixels: vec![255] };
+    let mut tree = ReactTree::with_icons(&ReactIcon::encode(&[icon]).unwrap()).unwrap();
+    let mut engine = Engine::new();
+    engine.set_viewport(720, height);
+    let mut ops = Vec::from(control(1, 0, HostKind::Screen, json!({ "title": "Settings" })));
+    ops.extend(children);
+    tree.apply(ReactCommit(ops), &mut engine).unwrap();
+    (tree, engine)
+}
+
+fn row(snapshot: &Value, id: i64, end: bool) -> &Value {
+    snapshot["controls"].as_array().unwrap().iter().find(|r| r["id"] == id && r["end"] == end).unwrap()
+}
+
+fn assert_click(engine: &mut Engine, id: i64, end: bool, event: &str, args: Value) {
+    assert!(engine.accessibility_click(id, end).activated);
+    let request = engine.take_native_request().unwrap();
+    assert_eq!(serde_json::from_str::<Value>(request.payload()).unwrap(),
+        json!({ "type": "event", "id": id, "name": event, "args": args }));
+    assert!(engine.take_native_request().is_none());
+}
+
+#[test]
+fn accessibility_uses_visible_titles_roles_and_current_actions() {
+    let toggle = |value| json!({ "label": "Português", "value": value, "onChange": true });
+    let ops = [
+        control(2, 1, HostKind::RowContent, json!({ "title": "Português", "subtitle": "Portuguese",
+            "onPress": true, "endIcon": "outlined:close", "onEndPress": true })),
+        control(3, 1, HostKind::Toggle, toggle(false)),
+        control(4, 1, HostKind::Field, json!({ "label": "Spelling", "onPress": true })),
+        control(5, 4, HostKind::RawText, json!({ "text": "Portugal" })),
+        control(6, 1, HostKind::Button, json!({ "onPress": true, "selected": true })),
+        control(7, 6, HostKind::RawText, json!({ "text": "Portugal" })),
+        control(8, 1, HostKind::Field, json!({ "label": "Shorter", "onPress": true, "disabled": true })),
+    ].into_iter().flatten().collect();
+    let (mut tree, mut engine) = page(1800, ops);
+    tree.apply(ReactCommit(vec![Operation::Update { id: 1,
+        props: json!({ "title": "Settings", "rightIcon": "outlined:close", "onRightPress": true }).as_object().unwrap().clone()
+    }]), &mut engine).unwrap();
+    let snapshot = engine.accessibility_snapshot();
+    assert_eq!(snapshot["controls"].as_array().unwrap().len(), 7);
+    assert_eq!(row(&snapshot, 1, true)["text"], "×");
+    assert_click(&mut engine, 1, true, "onRightPress", json!([]));
+    assert_eq!(row(&snapshot, 2, false)["text"], "Português");
+    assert_eq!(row(&snapshot, 2, false)["detail"], "Portuguese");
+    assert_eq!(row(&snapshot, 2, true)["text"], "×");
+    let primary_right = row(&snapshot, 2, false)["bounds"][2].as_i64().unwrap();
+    let end_left = row(&snapshot, 2, true)["bounds"][0].as_i64().unwrap();
+    assert!((primary_right - end_left).abs() <= 1);
+    assert_eq!(row(&snapshot, 3, false)["role"], "switch");
+    assert_eq!(row(&snapshot, 3, false)["text"], "Português");
+    assert_eq!(row(&snapshot, 3, false)["checked"], false);
+    assert_eq!(row(&snapshot, 4, false)["detail"], "Portugal");
+    assert_eq!(row(&snapshot, 6, false)["text"], "Portugal");
+    assert_eq!(row(&snapshot, 6, false)["role"], "radio");
+    assert_eq!(row(&snapshot, 6, false)["checked"], true);
+    assert_eq!(row(&snapshot, 8, false)["enabled"], false);
+    assert!(!engine.accessibility_click(8, false).activated);
+    assert_click(&mut engine, 2, false, "onPress", json!([]));
+    assert_click(&mut engine, 2, true, "onEndPress", json!([]));
+    assert_click(&mut engine, 3, false, "onChange", json!([true]));
+    tree.apply(ReactCommit(vec![Operation::Update { id: 3, props: toggle(true).as_object().unwrap().clone() }]), &mut engine).unwrap();
+    assert_eq!(row(&engine.accessibility_snapshot(), 3, false)["checked"], true);
+    assert_click(&mut engine, 3, false, "onChange", json!([false]));
+}
