+#[unsafe(no_mangle)]
+pub extern "system" fn Java_com_vandam_ink_InkNative_nativeSetAccent(
+    _env: EnvUnowned<'_>,
+    _class: JClass<'_>,
+    handle: jlong,
+    argb: jint,
+) {
+    if let Some(engine) = engine(handle) {
+        let mut engine = engine.lock_arc();
+        // 0, fully transparent, keeps the theme's own accent.
+        let accent = (argb != 0).then(|| {
+            let channel = |shift: u32| ((argb as u32 >> shift) & 0xFF) as f32 / 255.0;
+            ink_core::Colour { red: channel(16), green: channel(8), blue: channel(0), alpha: channel(24) }
+        });
+        if engine.engine.set_accent(accent) {
+            engine.notify_layout_inputs();
+        }
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_com_vandam_ink_InkNative_nativeSetUserScale(
+    _env: EnvUnowned<'_>,
+    _class: JClass<'_>,
+    handle: jlong,
+    scale: jfloat,
+) {
+    if let Some(engine) = engine(handle) {
+        let mut engine = engine.lock_arc();
+        if engine.engine.set_user_scale(scale) {
+            engine.notify_layout_inputs();
+        }
+    }
+}
