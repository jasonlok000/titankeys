@@ -0,0 +1,49 @@
+package com.vandam.ink
+
+import android.graphics.Paint
+import android.graphics.Typeface
+import android.graphics.fonts.Font
+import android.graphics.fonts.FontFamily
+import android.graphics.text.TextRunShaper
+import java.io.File
+import java.io.IOException
+import java.util.Locale
+import java.util.concurrent.ConcurrentHashMap
+
+internal object SystemTextShaper {
+    private const val EM_SIZE = 1000f
+    private val faces = ConcurrentHashMap<String, Typeface>()
+
+    // Advance, then glyph ID and baseline-relative x/y for each glyph, all positions in em units.
+    fun shape(path: String, text: String): FloatArray? {
+        return try {
+            val typeface = faces.computeIfAbsent(path) {
+                val font = Font.Builder(File(it)).build()
+                val family = FontFamily.Builder(font).build()
+                Typeface.CustomFallbackBuilder(family).build()
+            }
+            val paint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.SUBPIXEL_TEXT_FLAG).apply {
+                this.typeface = typeface
+                textSize = EM_SIZE
+                textLocale = Locale.forLanguageTag(if (path.contains("Devanagari")) "hi" else "th")
+            }
+            val run = TextRunShaper.shapeTextRun(text, 0, text.length, 0, text.length, 0f, 0f, false, paint)
+            FloatArray(1 + run.glyphCount() * 3).apply {
+                this[0] = run.advance / EM_SIZE
+                for (index in 0 until run.glyphCount()) {
+                    val font = run.getFont(index)
+                    // Rust can only use glyph IDs from the exact face it loaded, at face index zero.
+                    if (font.file?.absolutePath != path || font.ttcIndex != 0 || run.getGlyphId(index) == 0) return null
+                    val at = 1 + index * 3
+                    this[at] = run.getGlyphId(index).toFloat()
+                    this[at + 1] = run.getGlyphX(index) / EM_SIZE
+                    this[at + 2] = run.getGlyphY(index) / EM_SIZE
+                }
+            }
+        } catch (_: IOException) {
+            null
+        } catch (_: IllegalArgumentException) {
+            null
+        }
+    }
+}
