+#[test]
+fn accessibility_tracks_scroll_between_layouts_and_rejects_offscreen_actions() {
+    let ops = (2..42).flat_map(|id| control(id, 1, HostKind::Field,
+        json!({ "label": format!("Language {id}"), "onPress": true }))).collect();
+    let (_, mut engine) = page(800, ops);
+    let initial = engine.accessibility_snapshot();
+    let clip = engine.scene.scroll_clip.unwrap();
+    let bounds = &row(&initial, 2, false)["bounds"];
+    let origin = engine.scene.scroll_origin;
+    let delta = (bounds[1].as_i64().unwrap() + bounds[3].as_i64().unwrap()) as f32 / 2.0 - clip.y;
+    assert!(engine.scroll_by(delta));
+    assert_eq!(engine.scene.scroll_origin, origin, "exercise native scrolling between layout passes");
+    let partial = engine.accessibility_snapshot();
+    assert_eq!(row(&partial, 2, false)["bounds"][1], clip.y.floor() as i64);
+    assert!(row(&partial, 2, false)["bounds"][3].as_i64().unwrap() < bounds[3].as_i64().unwrap());
+    assert!(engine.scroll_by(engine.scene.scroll_max));
+    let last = engine.accessibility_snapshot();
+    assert!(last["controls"].as_array().unwrap().iter().all(|r| r["id"] != 2));
+    assert!(!engine.accessibility_click(2, false).activated);
+    assert_eq!(last["forward"], false);
+    assert_eq!(last["backward"], true);
+}
