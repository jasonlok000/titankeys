diff --git a/platform/android/native/src/text_shaping.rs b/platform/android/native/src/text_shaping.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b3c3779653fca7e98a729830e95fb046ca8463be
--- /dev/null
+++ b/platform/android/native/src/text_shaping.rs
@@ -0,0 +1,81 @@
+use std::sync::OnceLock;
+
+use ink_core::{PlatformGlyph, PlatformTextShape};
+use jni::{
+    Env, JavaVM, jni_sig, jni_str,
+    objects::{JClass, JFloatArray, JString, JValue},
+    refs::Global,
+};
+
+struct AndroidShaper {
+    vm: JavaVM,
+    class: Global<JClass<'static>>,
+}
+
+static SHAPER: OnceLock<AndroidShaper> = OnceLock::new();
+
+pub(super) fn install(env: &mut Env<'_>, class: &JClass<'_>) -> jni::errors::Result<()> {
+    if SHAPER.get().is_none() {
+        let _ = SHAPER.set(AndroidShaper {
+            vm: env.get_java_vm()?,
+            class: env.new_global_ref(class)?,
+        });
+    }
+    ink_core::set_platform_text_shaper(shape);
+    Ok(())
+}
+
+fn shape(path: &str, text: &str) -> Option<PlatformTextShape> {
+    let shaper = SHAPER.get()?;
+    shaper
+        .vm
+        .attach_current_thread(|env| {
+            env.with_local_frame(8, |env| -> jni::errors::Result<Option<PlatformTextShape>> {
+                let path = JString::from_str(env, path)?;
+                let text = JString::from_str(env, text)?;
+                let result = env
+                    .call_static_method(
+                        &shaper.class,
+                        jni_str!("shapeSystemText"),
+                        jni_sig!("(Ljava/lang/String;Ljava/lang/String;)[F"),
+                        &[JValue::Object(&path), JValue::Object(&text)],
+                    )?
+                    .l()?;
+                if result.is_null() {
+                    return Ok(None);
+                }
+                let result = JFloatArray::cast_local(env, result)?;
+                let mut values = vec![0.0; result.len(env)?];
+                result.get_region(env, 0, &mut values)?;
+                Ok(decode(&values))
+            })
+        })
+        .ok()
+        .flatten()
+}
+
+fn decode(values: &[f32]) -> Option<PlatformTextShape> {
+    let (&advance, glyphs) = values.split_first()?;
+    if !advance.is_finite() || advance < 0.0 || glyphs.len() % 3 != 0 {
+        return None;
+    }
+    let glyphs = glyphs
+        .chunks_exact(3)
+        .map(|g| {
+            let [id, x, y] = [g[0], g[1], g[2]];
+            if !(1.0..=f32::from(u16::MAX)).contains(&id)
+                || id.fract() != 0.0
+                || !x.is_finite()
+                || !y.is_finite()
+            {
+                return None;
+            }
+            Some(PlatformGlyph {
+                id: id as u16,
+                x,
+                y,
+            })
+        })
+        .collect::<Option<Vec<_>>>()?;
+    Some(PlatformTextShape { advance, glyphs })
+}
