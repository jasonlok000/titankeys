+#[test]
+fn accessibility_reads_the_screen_and_section_headings() {
+    let (_, mut engine) = page(1400, Vec::from(control(2, 1, HostKind::SectionTitle,
+        json!({ "title": "Cantonese" }))));
+    let snapshot = engine.accessibility_snapshot();
+    assert_eq!(snapshot["title"], "Settings");
+    let heading = row(&snapshot, 2, false);
+    assert_eq!(heading["text"], "Cantonese");
+    assert_eq!(heading["role"], "heading");
+    assert_eq!(heading["click"], false);
+    assert!(!engine.accessibility_click(2, false).activated);
+}
