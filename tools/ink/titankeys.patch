+package com.vandam.ink
+
+import android.graphics.Rect
+import android.os.Bundle
+import android.view.MotionEvent
+import android.view.View
+import android.view.accessibility.AccessibilityEvent
+import android.view.accessibility.AccessibilityManager
+import android.view.accessibility.AccessibilityNodeInfo
+import android.view.accessibility.AccessibilityNodeProvider
+import org.json.JSONObject
+
+/** Android's view of the controls drawn in the current Ink viewport. All bounds from Ink are surface pixels. */
+internal class InkAccessibility(
+    private val host: View,
+    private val read: (Long, Float) -> String,
+    private val click: (Long, Boolean) -> Boolean,
+    private val scroll: (Float) -> Boolean,
+) : AccessibilityNodeProvider() {
+    private data class Key(val node: Long, val end: Boolean)
+    private data class Control(
+        val key: Key, val text: String, val detail: String, val role: String,
+        val enabled: Boolean, val checked: Boolean?, val clickable: Boolean, val bounds: Rect,
+    ) {
+        val className get() = when (role) {
+            "switch" -> "android.widget.Switch"
+            "radio" -> "android.widget.RadioButton"
+            "button" -> "android.widget.Button"
+            else -> "android.widget.TextView"
+        }
+    }
+
+    private val manager = requireNotNull(host.context.getSystemService(AccessibilityManager::class.java))
+    private var controls = linkedMapOf<Int, Control>()
+    private var nextId = 1
+    private var focused: Int? = null
+    private var hovered: Int? = null
+    private var revision = -1L
+    private var offset = 0f
+    private var title = ""
+    private var forward = false
+    private var backward = false
+    private val notifyChanged = Runnable { send(HOST_VIEW_ID, AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED) }
+
+    fun clear() {
+        host.removeCallbacks(notifyChanged)
+        controls.clear()
+        focused = null
+        hovered = null
+        title = ""
+        revision = -1L
+        forward = false
+        backward = false
+    }
+
+    fun frame() {
+        if (revision >= 0 && manager.isEnabled) refresh()
+    }
+
+    private fun refresh() {
+        val data = read(revision, offset)
+        if (data.isEmpty()) return
+        val snapshot = JSONObject(data)
+        val rows = snapshot.getJSONArray("controls")
+        val previousIds = controls.entries.associate { (id, row) -> row.key to id }
+        val next = linkedMapOf<Int, Control>()
+        for (index in 0 until rows.length()) {
+            val row = rows.getJSONObject(index)
+            val key = Key(row.getLong("id"), row.getBoolean("end"))
+            val box = row.getJSONArray("bounds")
+            val id = previousIds[key] ?: nextId++
+            next[id] = Control(key, row.getString("text"), row.getString("detail"), row.getString("role"),
+                row.getBoolean("enabled"), if (row.isNull("checked")) null else row.getBoolean("checked"),
+                row.getBoolean("click"), Rect(box.getInt(0), box.getInt(1), box.getInt(2), box.getInt(3)))
+        }
+        focused?.takeUnless(next::containsKey)?.let { send(it, AccessibilityEvent.TYPE_VIEW_ACCESSIBILITY_FOCUS_CLEARED); focused = null }
+        hovered?.takeUnless(next::containsKey)?.let { send(it, AccessibilityEvent.TYPE_VIEW_HOVER_EXIT); hovered = null }
+        val canAdvance = snapshot.getBoolean("forward")
+        val canRetreat = snapshot.getBoolean("backward")
+        val nextTitle = snapshot.getString("title")
+        val changed = nextTitle != title || next != controls || forward != canAdvance || backward != canRetreat
+        if (changed && revision >= 0) {
+            host.removeCallbacks(notifyChanged)
+            host.post(notifyChanged)
+        }
+        title = nextTitle
+        controls = next
+        forward = canAdvance
+        backward = canRetreat
+        revision = snapshot.getLong("revision")
+        offset = snapshot.getDouble("offset").toFloat()
+    }
+
+    override fun createAccessibilityNodeInfo(virtualViewId: Int): AccessibilityNodeInfo? {
+        refresh()
+        if (virtualViewId == HOST_VIEW_ID) {
+            return AccessibilityNodeInfo.obtain(host).also { info ->
+                host.onInitializeAccessibilityNodeInfo(info)
+                if (title.isNotBlank()) {
+                    info.paneTitle = title
+                    info.contentDescription = title
+                }
+                for (id in controls.keys) info.addChild(host, id)
+                info.isScrollable = forward || backward
+                if (forward) info.addAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_SCROLL_FORWARD)
+                if (backward) info.addAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_SCROLL_BACKWARD)
+            }
+        }
+        val row = controls[virtualViewId] ?: return null
+        val rect = Rect(row.bounds)
+        val visible = Rect()
+        if (!host.getLocalVisibleRect(visible) || !rect.intersect(visible)) return null
+        return AccessibilityNodeInfo.obtain().also { info ->
+            info.setSource(host, virtualViewId)
+            info.setParent(host)
+            info.packageName = host.context.packageName
+            info.className = row.className
+            info.text = row.text
+            if (row.detail.isNotEmpty()) {
+                if (row.checked == null) info.stateDescription = row.detail
+                else info.contentDescription = listOf(row.text, row.detail).joinToString(", ")
+            }
+            info.isEnabled = row.enabled
+            info.isClickable = row.clickable
+            info.isHeading = row.role == "heading"
+            info.isCheckable = row.checked != null
+            info.isChecked = row.checked == true
+            info.isSelected = row.role == "radio" && row.checked == true
+            info.isVisibleToUser = host.isShown && host.windowVisibility == View.VISIBLE
+            info.isFocusable = true
+            info.isAccessibilityFocused = virtualViewId == focused
+            info.setBoundsInParent(rect)
+            val position = IntArray(2)
+            host.getLocationOnScreen(position)
+            rect.offset(position[0], position[1])
+            info.setBoundsInScreen(rect)
+            if (row.clickable) info.addAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_CLICK)
+            info.addAction(if (info.isAccessibilityFocused) AccessibilityNodeInfo.AccessibilityAction.ACTION_CLEAR_ACCESSIBILITY_FOCUS
+                else AccessibilityNodeInfo.AccessibilityAction.ACTION_ACCESSIBILITY_FOCUS)
+        }
+    }
+
+    override fun findFocus(focus: Int): AccessibilityNodeInfo? =
+        if (focus == AccessibilityNodeInfo.FOCUS_ACCESSIBILITY) focused?.let(::createAccessibilityNodeInfo) else null
+
+    override fun findAccessibilityNodeInfosByText(text: String, virtualViewId: Int): List<AccessibilityNodeInfo> {
+        refresh()
+        return controls.filter { (id, row) ->
+            (virtualViewId == HOST_VIEW_ID || id == virtualViewId) && row.text.contains(text, ignoreCase = true)
+        }.keys.mapNotNull(::createAccessibilityNodeInfo)
+    }
+
+    override fun performAction(virtualViewId: Int, action: Int, arguments: Bundle?): Boolean {
+        refresh()
+        if (virtualViewId == HOST_VIEW_ID) {
+            return when (action) {
+                AccessibilityNodeInfo.ACTION_SCROLL_FORWARD -> forward && scroll(host.height * 0.7f)
+                AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD -> backward && scroll(-host.height * 0.7f)
+                else -> host.performAccessibilityAction(action, arguments)
+            }
+        }
+        val row = controls[virtualViewId] ?: return false
+        return when (action) {
+            AccessibilityNodeInfo.ACTION_CLICK -> {
+                val activated = row.enabled && row.clickable && click(row.key.node, row.key.end)
+                if (activated) send(virtualViewId, AccessibilityEvent.TYPE_VIEW_CLICKED)
+                activated
+            }
+            AccessibilityNodeInfo.ACTION_ACCESSIBILITY_FOCUS -> {
+                if (focused == virtualViewId) return false
+                focused?.let { send(it, AccessibilityEvent.TYPE_VIEW_ACCESSIBILITY_FOCUS_CLEARED) }
+                focused = virtualViewId
+                send(virtualViewId, AccessibilityEvent.TYPE_VIEW_ACCESSIBILITY_FOCUSED)
+                true
+            }
+            AccessibilityNodeInfo.ACTION_CLEAR_ACCESSIBILITY_FOCUS -> {
+                if (focused != virtualViewId) return false
+                focused = null
+                send(virtualViewId, AccessibilityEvent.TYPE_VIEW_ACCESSIBILITY_FOCUS_CLEARED)
+                true
+            }
+            else -> false
+        }
+    }
+
+    fun hover(event: MotionEvent): Boolean {
+        if (!manager.isEnabled || !manager.isTouchExplorationEnabled) return false
+        refresh()
+        val next = when (event.actionMasked) {
+            MotionEvent.ACTION_HOVER_ENTER, MotionEvent.ACTION_HOVER_MOVE ->
+                controls.entries.lastOrNull { it.value.bounds.contains(event.x.toInt(), event.y.toInt()) }?.key
+            MotionEvent.ACTION_HOVER_EXIT -> null
+            else -> return false
+        }
+        val previous = hovered
+        if (next != previous) {
+            hovered = next
+            next?.let { send(it, AccessibilityEvent.TYPE_VIEW_HOVER_ENTER) }
+            previous?.let { send(it, AccessibilityEvent.TYPE_VIEW_HOVER_EXIT) }
+        }
+        return next != null || previous != null
+    }
+
+    private fun send(id: Int, type: Int) {
+        if (!manager.isEnabled) return
+        val event = AccessibilityEvent.obtain(type)
+        event.packageName = host.context.packageName
+        event.className = controls[id]?.className ?: host.javaClass.name
+        if (id == HOST_VIEW_ID) event.setSource(host) else event.setSource(host, id)
+        controls[id]?.let { event.text.add(it.text); event.isEnabled = it.enabled; event.isChecked = it.checked == true }
+        if (type == AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED) event.contentChangeTypes = AccessibilityEvent.CONTENT_CHANGE_TYPE_SUBTREE
+        host.parent?.requestSendAccessibilityEvent(host, event)
+    }
+}
