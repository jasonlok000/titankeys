+/// Strips of the background over the fade band, from opaque at the header to clear at the
+/// content, drawn over scrolled content. Nothing is drawn at rest, when the band is empty.
+fn push_scroll_fade_instances(scene: &Scene, instances: &mut Vec<QuadInstance>) {
+    let Some(band) = scene.scroll_fade else {
+        return;
+    };
+    if scene.scroll_offset <= 0.0 {
+        return;
+    }
+    let strips = (band.height / 2.0).ceil().clamp(1.0, 48.0) as usize;
+    let strip = band.height / strips as f32;
+    let background = scene.background();
+    for index in 0..strips {
+        // Ease out, so the content is mostly gone by the header's edge.
+        let position = (index as f32 + 0.5) / strips as f32;
+        let alpha = (1.0 - position) * (1.0 - position) * (3.0 - 2.0 * (1.0 - position));
+        let rect = Rect { y: band.y + strip * index as f32, height: strip + 0.5, ..band };
+        push_quad_instance(instances, scene, &ink_core::Quad { rect, clip: band, colour: Colour { alpha: background.alpha * alpha, ..background }, scrolling: false });
+    }
