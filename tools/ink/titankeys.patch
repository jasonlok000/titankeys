+/// The fade band above scrolled content, from [top] to [bottom], with its top on a whole pixel. Scrolled content is cut at the
+/// band's top rounded down, so a band that started part way into a pixel left that row of content uncovered, at full strength,
+/// just under the header (TitanKeys, 2026-11-13). Its bottom stays at the content's edge.
+fn fade_band(x: f32, width: f32, top: f32, bottom: f32) -> Rect {
+    let top = top.floor();
+    Rect { x, y: top, width, height: (bottom - top).max(0.0) }
+}
+
+#[cfg(test)]
+mod fade_band_tests {
+    use super::*;
+
+    #[test]
+    fn the_fade_starts_on_the_row_where_scrolled_content_is_cut() {
+        for top in [267.0f32, 267.25, 267.5, 267.6, 267.99, 0.4] {
+            let band = fade_band(0.0, 1076.0, top, top + 40.0);
+            // The renderer cuts scrolled content at the band's top, rounded down: the fade must cover that row too.
+            assert_eq!(band.y, top.floor(), "top {top}");
+            assert_eq!(band.y.fract(), 0.0, "top {top}");
+            assert!((band.y + band.height - (top + 40.0)).abs() < 1e-4, "the bottom stays at the content, top {top}");
+        }
+    }
+}
