@@ -0,0 +1,194 @@
+//! Script runs that require OpenType substitution and positioning. The Android host supplies
+//! shaping for these two scripts, with the same system font used for glyph outlines.
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex, OnceLock};
+
+use ab_glyph::{Font, FontArc};
+
+use super::{FontRole, primary_font, text_graphemes};
+
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+pub enum ComplexScript {
+    Devanagari,
+    Thai,
+}
+
+fn script(character: char) -> Option<ComplexScript> {
+    match character {
+        '\u{0900}'..='\u{097f}' | '\u{a8e0}'..='\u{a8ff}' => Some(ComplexScript::Devanagari),
+        '\u{0e00}'..='\u{0e7f}' => Some(ComplexScript::Thai),
+        _ => None,
+    }
+}
+
+pub(crate) fn has_complex_text(text: &str) -> bool {
+    !text.is_ascii() && text.chars().any(|character| script(character).is_some())
+}
+
+pub fn text_spans(text: &str) -> impl Iterator<Item = (&str, Option<ComplexScript>)> {
+    let script_in = |grapheme: &str| grapheme.chars().next().and_then(script);
+    let mut graphemes = text_graphemes(text).peekable();
+    let mut start = 0;
+    std::iter::from_fn(move || {
+        let first = graphemes.next()?;
+        let script = script_in(first);
+        let mut end = start + first.len();
+        if script.is_some() {
+            while let Some(next) = graphemes.next_if(|grapheme| script_in(grapheme) == script) {
+                end += next.len();
+            }
+        }
+        let span = &text[start..end];
+        start = end;
+        Some((span, script))
+    })
+}
+
+/// A glyph's ID and baseline-relative position, in em units.
+pub struct PlatformGlyph {
+    pub id: u16,
+    pub x: f32,
+    pub y: f32,
+}
+
+pub struct PlatformTextShape {
+    pub advance: f32,
+    pub glyphs: Vec<PlatformGlyph>,
+}
+
+type PlatformShaper = fn(path: &str, text: &str) -> Option<PlatformTextShape>;
+static SHAPER: OnceLock<PlatformShaper> = OnceLock::new();
+
+pub fn set_platform_text_shaper(shaper: PlatformShaper) {
+    let _ = SHAPER.set(shaper);
+}
+
+struct ShapeFont {
+    path: &'static str,
+    font: FontArc,
+    raster_scale: f32,
+}
+
+fn shape_font(script: ComplexScript) -> Option<&'static ShapeFont> {
+    static DEVANAGARI: OnceLock<Option<ShapeFont>> = OnceLock::new();
+    static THAI: OnceLock<Option<ShapeFont>> = OnceLock::new();
+    let (font, paths): (&OnceLock<_>, &[&str]) = match script {
+        ComplexScript::Devanagari => (
+            &DEVANAGARI,
+            &[
+                "/system/fonts/NotoSansDevanagari-VF.ttf",
+                "/system/fonts/NotoSansDevanagari-Regular.ttf",
+                "/system/fonts/NotoSansDevanagariUI-VF.ttf",
+                "/system/fonts/NotoSansDevanagariUI-Regular.ttf",
+            ],
+        ),
+        ComplexScript::Thai => (
+            &THAI,
+            &[
+                "/system/fonts/NotoSansThai-Regular.ttf",
+                "/system/fonts/NotoSansThaiUI-Regular.ttf",
+            ],
+        ),
+    };
+    font.get_or_init(|| {
+        paths.iter().find_map(|&path| {
+            let font = FontArc::try_from_vec(std::fs::read(path).ok()?).ok()?;
+            let raster_scale = font.height_unscaled() / font.units_per_em()?;
+            Some(ShapeFont {
+                path,
+                font,
+                raster_scale,
+            })
+        })
+    })
+    .as_ref()
+}
+
+pub struct ShapedTextSpan {
+    pub font: &'static FontArc,
+    pub font_index: usize,
+    pub raster_size: u16,
+    pub em_size: f32,
+    pub shape: Arc<PlatformTextShape>,
+}
+
+pub fn shape_text_span(
+    text: &str,
+    script: ComplexScript,
+    size: f32,
+    role: FontRole,
+) -> Option<ShapedTextSpan> {
+    let shaper = SHAPER.get()?;
+    let font = shape_font(script)?;
+    let primary = primary_font(role);
+    // Ink's size uses the primary face's height. Use the same em size for advances and outlines.
+    let target_em = size * primary.units_per_em()? / primary.height_unscaled();
+    let raster_size = (target_em * font.raster_scale)
+        .round()
+        .clamp(1.0, u16::MAX as f32) as u16;
+    let em_size = f32::from(raster_size) / font.raster_scale;
+    let shape = if text.len() <= 512 {
+        type ShapesByFont = HashMap<&'static str, HashMap<String, Arc<PlatformTextShape>>>;
+        static CACHE: OnceLock<Mutex<ShapesByFont>> = OnceLock::new();
+        let mut cache = CACHE.get_or_init(Mutex::default).lock().ok()?;
+        let shapes = cache.entry(font.path).or_default();
+        if let Some(shape) = shapes.get(text) {
+            Arc::clone(shape)
+        } else {
+            let shape = Arc::new(shaper(font.path, text)?);
+            if shapes.len() >= 512 {
+                shapes.clear();
+            }
+            shapes.insert(text.to_owned(), Arc::clone(&shape));
+            shape
+        }
+    } else {
+        Arc::new(shaper(font.path, text)?)
+    };
+    // Built-in fallback faces occupy 1–6 and theme faces start at 64.
+    let font_index = 48 + script as usize;
+    Some(ShapedTextSpan {
+        font: &font.font,
+        font_index,
+        raster_size,
+        em_size,
+        shape,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{ComplexScript, has_complex_text, text_spans};
+
+    #[test]
+    fn isolates_complex_scripts_from_latin_emoji_and_rtl_text() {
+        use ComplexScript::{Devanagari, Thai};
+        let spans: Vec<_> = text_spans("Aहिन्दी ไทย🇨🇦א").collect();
+        assert_eq!(
+            spans,
+            vec![
+                ("A", None),
+                ("हिन्दी", Some(Devanagari)),
+                (" ", None),
+                ("ไทย", Some(Thai)),
+                ("🇨🇦", None),
+                ("א", None),
+            ]
+        );
+        assert!(!has_complex_text("ASCII א لع 🇨🇦"));
+        assert!(has_complex_text("Aตั้งค่า"));
+    }
+
+    #[test]
+    fn supplies_join_controls_and_marks_in_a_single_span() {
+        use ComplexScript::{Devanagari, Thai};
+        for (word, script) in [
+            ("क्\u{200d}ष", Devanagari),
+            ("क्\u{200c}ष", Devanagari),
+            ("कि", Devanagari),
+            ("น้ำ", Thai),
+        ] {
+            assert!(text_spans(word).eq([(word, Some(script))]));
+        }
+    }
+}
