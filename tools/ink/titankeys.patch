+use super::*;
+use serde_json::{json, Value};
+
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct StackLabel {
+    pub text: String,
+    pub value: String,
+    pub selected: Option<bool>,
+    pub enabled: bool,
+    pub clickable: bool,
+}
+
+pub(super) struct Control {
+    id: NodeIdentity,
+    end: bool,
+    rect: Rect,
+    scrolling: bool,
+    text: String,
+    detail: String,
+    role: &'static str,
+    enabled: bool,
+    checked: Option<bool>,
+    target: Option<PressTarget>,
+}
+
+fn row_label(children: &[Node], subtitle: bool) -> Option<&str> {
+    children.iter().find_map(|child| match &child.kind {
+        NodeKind::RowTitle { text, .. } if !subtitle => Some(text.as_str()),
+        NodeKind::Text { text, .. } if !subtitle => Some(text.as_str()),
+        NodeKind::RowSubtitle { text, .. } if subtitle => Some(text.as_str()),
+        NodeKind::Stack { children, .. } => row_label(children, subtitle),
+        _ => None,
+    })
+}
+
+pub(super) fn icon_label(icon: &str) -> Option<&'static str> {
+    match icon.rsplit(':').next()? {
+        "close" => Some("×"),
+        "arrow_back" => Some("←"),
+        "arrow_back_ios" => Some("‹"),
+        _ => None,
+    }
+}
+
+impl Engine {
+    pub(super) fn header_control(&mut self, rect: Rect, text: &str, action: &Action, end: bool) {
+        if self.accessibility_enabled {
+            self.accessible.push(Control {
+                id: self.layout_owner, end, rect, scrolling: false, text: text.to_owned(), detail: String::new(),
+                role: "button", enabled: true, checked: None, target: Some(self.press_target(action)),
+            });
+        }
+    }
+
+    pub(super) fn collect_control(&mut self, node: &Node, rect: Rect) {
+        if node.identity.0 == 0 { return; }
+        let mut add = |rect: Rect, text: &str, detail: &str, role, enabled, checked, target, end| {
+            let rect = rect.intersection(self.clip);
+            if !text.is_empty() && rect.width > 0.0 && rect.height > 0.0 {
+                self.accessible.push(Control {
+                    id: node.identity, end, rect, scrolling: self.scrolling, text: text.to_owned(),
+                    detail: detail.to_owned(), role, enabled, checked, target,
+                });
+            }
+        };
+        let event = |name| Some(PressTarget { node: node.identity, role: PressRole::Event(name) });
+        match &node.kind {
+            NodeKind::Field { label, value, action, disabled } => {
+                let role = if action.is_some() || *disabled { "button" } else { "text" };
+                add(rect, label, value, role, !disabled, None, action.as_ref().and(event("onPress")), false);
+            }
+            NodeKind::SectionTitle { title, .. } => {
+                add(rect, title, "", "heading", true, None, None, false);
+            }
+            NodeKind::Toggle { label, subtitle, value, action, .. } => {
+                add(rect, label, subtitle.as_deref().unwrap_or_default(), "switch", action.is_some(),
+                    Some(*value), action.as_ref().and(event("onChange")), false);
+            }
+            NodeKind::Button { label, selectable, underline, action, .. } => {
+                add(rect, label, "", if *selectable { "radio" } else { "button" }, action.is_some(),
+                    selectable.then_some(*underline), action.as_ref().and(event("onPress")), false);
+            }
+            NodeKind::Row { children, action, end, end_label, .. } => {
+                let Some(title) = row_label(children, false) else { return };
+                let detail = row_label(children, true).unwrap_or_default();
+                let separate_end = matches!(end, Some((_, Some(_))));
+                // The end button has its own hit region at the trailing edge of the row.
+                let end_width = if separate_end {
+                    rect.height.max((ROW_END_ICON_SIZE + 2.0 * BUTTON_ICON_GAP) * self.viewport.scale).min(rect.width)
+                } else { 0.0 };
+                let primary = Rect { width: rect.width - end_width, ..rect };
+                add(primary, title, detail, if action.is_some() { "button" } else { "text" }, true,
+                    None, action.as_ref().and(event("onPress")), false);
+                if separate_end {
+                    add(Rect { x: rect.x + primary.width, width: end_width, ..rect },
+                        end_label.as_deref().unwrap_or(title), title, "button", true, None, event("onEndPress"), true);
+                }
+            }
+            NodeKind::Stack { accessible: Some(label), .. } => {
+                let role = if label.selected.is_some() { "radio" } else if label.clickable { "button" } else { "text" };
+                let target = if label.clickable && label.enabled { event("onPress") } else { None };
+                add(rect, &label.text, &label.value, role, label.enabled, label.selected, target, false);
+            }
+            _ => {}
+        }
+    }
+
+    fn control_bounds(&self, control: &Control) -> Option<Rect> {
+        let mut rect = control.rect;
+        if control.scrolling {
+            rect.y += self.scene.scroll_origin - self.scene.scroll_offset;
+            rect = rect.intersection(self.scene.scroll_clip?);
+        }
+        rect = rect.intersection(Rect {
+            width: self.viewport.width as f32, height: self.viewport.height as f32, ..Rect::default()
+        });
+        (rect.width > 0.0 && rect.height > 0.0).then_some(rect)
+    }
+
+    pub fn accessibility_snapshot(&mut self) -> Value {
+        if !self.accessibility_enabled {
+            self.accessibility_enabled = true;
+            self.relayout_scene();
+        }
+        let controls: Vec<_> = self.accessible.iter().filter_map(|control| {
+            let rect = self.control_bounds(control)?;
+            Some(json!({
+                "id": control.id.0 as i64, "end": control.end, "text": control.text,
+                "detail": control.detail, "role": control.role, "enabled": control.enabled,
+                "checked": control.checked, "click": control.target.is_some(),
+                "bounds": [rect.x.floor() as i32, rect.y.floor() as i32,
+                    (rect.x + rect.width).ceil() as i32, (rect.y + rect.height).ceil() as i32]
+            }))
+        }).collect();
+        let title = match &self.root.kind {
+            NodeKind::Screen(screen) => screen.title.as_deref(),
+            _ => None,
+        };
+        json!({ "title": title.unwrap_or_default(), "controls": controls, "revision": self.scene.revision, "offset": self.scene.scroll_offset, "backward": self.scene.scroll_offset > 0.0,
+            "forward": self.scene.scroll_offset < self.scene.scroll_max })
+    }
+
+    pub fn accessibility_click(&mut self, id: i64, end: bool) -> PointerOutcome {
+        let target = self.accessible.iter()
+            .find(|c| c.id.0 == id as usize && c.end == end && self.control_bounds(c).is_some())
+            .and_then(|c| c.target);
+        let Some(region) = target.and_then(|target| self.hit_regions.iter().find(|r| r.target == target)) else {
+            return PointerOutcome::default();
+        };
+        let action = region.action.clone();
+        let preserve_input = region.preserve_input;
+        let haptic = region.haptic;
+        let revision = self.scene.revision;
+        let activated = self.apply_tap_action(Some(action), preserve_input);
+        PointerOutcome { activated, haptic: activated && haptic, changed: self.scene.revision != revision, captured: false }
+    }
+}
+
+#[cfg(test)]
+#[path = "../../../test/unit/core-accessibility.rs"]
+mod tests;
